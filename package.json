{
  "name": "edgewave",
  "displayName": "EDGEwave",
  "description": "The sound studio for Cyberpunk 2077 modding: edit, mix and re-voice the game's sounds and put them into your mod. Builds on REDcode.",
  "preview": true,
  "publisher": "edgemodders",
  "version": "0.1.0",
  "license": "MIT",
  "galleryBanner": {
    "color": "#08090d",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Edgemodders/EDGEwave"
  },
  "homepage": "https://edgemodders.github.io/EDGEwave/",
  "bugs": {
    "url": "https://github.com/Edgemodders/EDGEwave/issues"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "cyberpunk",
    "cyberpunk 2077",
    "modding",
    "audio",
    "sound",
    "redmod",
    "elevenlabs",
    "edgewave",
    "redcode"
  ],
  "icon": "docs/assets/brand/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [],
  "extensionDependencies": [
    "edgemodders.redcode-cyberpunk"
  ],
  "contributes": {
    "commands": [
      {
        "command": "edgewave.open",
        "title": "Open Sound in EDGEwave…",
        "category": "EDGEwave",
        "icon": "$(folder-opened)"
      },
      {
        "command": "edgewave.newSound",
        "title": "Create a Sound…",
        "category": "EDGEwave",
        "icon": "$(add)"
      },
      {
        "command": "edgewave.voiceLines",
        "title": "Voice Lines…",
        "category": "EDGEwave"
      },
      {
        "command": "edgewave.connectAssistant",
        "title": "Connect an Assistant (MCP)…",
        "category": "EDGEwave"
      },
      {
        "command": "edgewave.openSound",
        "title": "Open Sound Reference",
        "category": "EDGEwave"
      },
      {
        "command": "edgewave.refreshSounds",
        "title": "Refresh",
        "category": "EDGEwave",
        "icon": "$(refresh)"
      },
      {
        "command": "edgewave.forgetRecent",
        "title": "Remove from Recent",
        "category": "EDGEwave",
        "icon": "$(close)"
      },
      {
        "command": "edgewave.clearRecent",
        "title": "Clear Recent",
        "category": "EDGEwave",
        "icon": "$(clear-all)"
      },
      {
        "command": "edgewave.openFolder",
        "title": "Open Folder…",
        "category": "EDGEwave",
        "icon": "$(folder-opened)"
      },
      {
        "command": "edgewave.elevenlabs.setKey",
        "title": "Set ElevenLabs API Key",
        "category": "EDGEwave"
      },
      {
        "command": "edgewave.elevenlabs.clearKey",
        "title": "Clear ElevenLabs API Key",
        "category": "EDGEwave"
      },
      {
        "command": "edgewave.elevenlabs.voices",
        "title": "ElevenLabs Voices Made by EDGEwave…",
        "category": "EDGEwave"
      }
    ],
    "configuration": {
      "title": "EDGEwave",
      "properties": {
        "edgewave.elevenlabs.sampleRate": {
          "type": "number",
          "enum": [
            48000,
            44100,
            32000,
            24000,
            22050,
            16000
          ],
          "default": 48000,
          "markdownDescription": "The sample rate the voice tools ask ElevenLabs for (as 16-bit PCM). 44100 needs ElevenLabs' Pro plan. If your plan refuses a rate, EDGEwave uses 24000 from then on."
        },
        "edgewave.elevenlabs.speechModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "The model Speak Line starts with, such as `eleven_multilingual_v2` or `eleven_v3`. Empty: ElevenLabs' default. Speak Line lists your account's models."
        },
        "edgewave.elevenlabs.voiceChangerModel": {
          "type": "string",
          "default": "eleven_multilingual_sts_v2",
          "markdownDescription": "The speech-to-speech model Re-Voice starts with."
        },
        "edgewave.voiceLines.model": {
          "type": "string",
          "default": "eleven_v3",
          "markdownDescription": "The ElevenLabs model Voice Lines speaks a quest's lines with. `eleven_v3` reads the delivery tags (`[softly]`, `[sighs]`) in a line's `say`; other models get them removed. The MCP tool `voice_lines` uses it too."
        },
        "edgewave.elevenlabs.baseUrl": {
          "type": "string",
          "default": "https://api.elevenlabs.io",
          "markdownDescription": "ElevenLabs' API server. For data residency: `https://api.us.elevenlabs.io`, `https://api.eu.residency.elevenlabs.io`, `https://api.in.residency.elevenlabs.io`, `https://api.sg.residency.elevenlabs.io`."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "edgewave.openSound",
          "when": "false"
        },
        {
          "command": "edgewave.refreshSounds",
          "when": "false"
        },
        {
          "command": "edgewave.forgetRecent",
          "when": "false"
        },
        {
          "command": "edgewave.clearRecent",
          "when": "false"
        },
        {
          "command": "edgewave.openFolder",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "edgewave.open",
          "when": "resourceExtname =~ /^\\.(wav|ogg|mp3|flac|opus|wem)$/i",
          "group": "navigation@90"
        }
      ],
      "view/title": [
        {
          "command": "edgewave.newSound",
          "when": "view == edgewave.sounds",
          "group": "navigation@1"
        },
        {
          "command": "edgewave.open",
          "when": "view == edgewave.sounds",
          "group": "navigation@2"
        },
        {
          "command": "edgewave.refreshSounds",
          "when": "view == edgewave.sounds",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "edgewave.open",
          "when": "view == redcode.project && viewItem =~ /^projectFile\\.sound/",
          "group": "edgewave@1"
        },
        {
          "command": "edgewave.forgetRecent",
          "when": "view == edgewave.sounds && viewItem == edgewave.recentSound",
          "group": "inline"
        },
        {
          "command": "edgewave.forgetRecent",
          "when": "view == edgewave.sounds && viewItem == edgewave.recentSound",
          "group": "edgewave@1"
        },
        {
          "command": "edgewave.clearRecent",
          "when": "view == edgewave.sounds && viewItem == edgewave.recentGroup",
          "group": "inline"
        },
        {
          "command": "edgewave.openFolder",
          "when": "view == edgewave.sounds && viewItem == edgewave.noFolder",
          "group": "inline"
        },
        {
          "command": "edgewave.clearRecent",
          "when": "view == edgewave.sounds && viewItem == edgewave.recentGroup",
          "group": "edgewave@1"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "edgewave.mcp",
        "label": "EDGEwave"
      }
    ],
    "customEditors": [
      {
        "viewType": "edgewave.sound",
        "displayName": "EDGEwave Sound Editor",
        "selector": [
          {
            "filenamePattern": "*.edgewave"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "json",
        "extensions": [
          ".edgewave"
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "edgewave",
          "title": "EDGEwave",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "edgewave": [
        {
          "id": "edgewave.sounds",
          "name": "Sounds"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "edgewave.sounds",
        "contents": "No sound documents yet, in this folder or opened lately.\nOpen a game sound from REDcode's sound list with Open in EDGEwave, or open a sound file.\n[Browse Game Sounds](command:redcode.browseSounds)\n[Open Sound…](command:edgewave.open)"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "test": "node esbuild.mjs --tests && node --test \"dist-test/*.test.cjs\"",
    "smoke": "node tools/smoke/smoke.mjs",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies --readme-path README.marketplace.md",
    "nexus-zip": "node tools/nexus-zip.mjs",
    "release:notes": "node tools/release-notes.mjs",
    "vsix-test": "node tools/vsix-test.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.0.0",
    "@types/vscode": "1.80.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "typescript": "~5.9.3",
    "zod": "^3.25.76"
  }
}
